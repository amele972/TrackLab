# pyenv
#   For a library or package, you might want to ignore these files since the values are
#   specific to the developer's environment.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in git
#   unless you're developing an isotope or package.
#   For development, you should ignore Pipfile.lock.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally recommended to be committed.
#   However, for libraries, it might be ignored.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally recommended to be committed.
# pdm.lock
#   pdm flags inside project directory
.pdm-plugins/
.pdm-build/

# PEP 582; used by e.g. github.com/lincolnloop/layman and github.com/pdm-project/pdm
__pypackages__/

